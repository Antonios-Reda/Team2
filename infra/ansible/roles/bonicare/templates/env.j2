# Ansible Managed: BoniCare Environment Configuration ({{ environment_tier | upper }})

# General Application Settings
NODE_ENV={{ environment_tier }}
APP_DOMAIN={{ app_domain }}
CORS_ORIGINS={{ cors_origins }}
LOG_LEVEL={{ log_level }}

# Container Networking and Database Connection Strings
MONGODB_URI={{ mongodb_uri }}
REDIS_URL={{ redis_url }}

# Microservices Ports
BACKEND_PORT={{ services.backend.container_port }}
FRONTEND_PORT={{ services.frontend.container_port }}
AI_SERVICE_PORT={{ services.ai.container_port }}
WEBRTC_PORT={{ services.webrtc.container_port }}

# Resource Allocation (Passed to Docker Compose)
AI_CPUS={{ resources.ai_service.cpus }}
AI_MEMORY={{ resources.ai_service.memory }}
BACKEND_CPUS={{ resources.backend.cpus }}
BACKEND_MEMORY={{ resources.backend.memory }}

# Feature Flags
ENABLE_AI_TELEMETRY={{ enable_ai_telemetry | lower }}

# Image Tagging (Passed from Jenkins Pipeline, defaults to latest)
IMAGE_TAG={{ image_tag | default('latest') }}
DOCKER_REGISTRY={{ docker_registry }}/{{ docker_namespace }}