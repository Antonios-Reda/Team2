pipeline {
    agent any
    
    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
    }

    environment {
        DOCKER_BUILDKIT = "1"
        COMPOSE_DOCKER_CLI_BUILD = "1"

        REGISTRY = "docker.io"
        NAMESPACE = "keroliskhalaf"

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout Repository') {
            steps {
                cleanWs()

                script {

                    def branch = env.BRANCH_NAME ?: "DevOps-dev"

                    if (!(branch in ["DevOps-dev", "main"])) {
                        error("Branch ${branch} is not allowed.")
                    }

                    git(
                        branch: branch,
                        url: 'https://github.com/Antonios-Reda/Team2.git'
                    )

                    env.GIT_SHA = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()

                    echo "Building Branch: ${branch}"
                    echo "Commit: ${env.GIT_SHA}"
                }
            }
        }
        stage('Docker Login') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub_id',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    sh '''
                    echo "$DOCKER_PASS" | docker login \
                        -u "$DOCKER_USER" \
                        --password-stdin
                    '''

                }
            }
        }

        stage('Create Buildx Builder') {

            steps {

                sh '''

                docker buildx inspect bonicare-builder >/dev/null 2>&1 || \
                docker buildx create --name bonicare-builder --driver docker-container

                docker buildx use bonicare-builder

                docker buildx inspect --bootstrap

                '''

            }

        }

        stage('Build & Push Images') {

            steps {

                sh '''

                docker buildx bake \
                    --push \
                    --file ci/docker-bake.hcl \
                    --set VERSION='${IMAGE_TAG}' \
                    --set REGISTRY='${REGISTRY}' \
                    --set NAMESPACE='${NAMESPACE}'

                '''

            }

        }

        stage('Deploy to Production') {

            steps {

                sh '''

                ansible-playbook \
                    -i infra/ansible/inventory/prod.ini \
                    infra/ansible/deploy.yml \
                    -e image_tag=${IMAGE_TAG} \
                    --vault-password-file=.vault_pass

                '''

            }

        }
    }

    post {

        success {

            echo 'Pipeline Finished Successfully'

        }

        failure {

            echo 'Deployment failed!'

            script {

                if (fileExists('infra/ansible/rollback_logic.yml')) {

                    sh '''

                    ansible-playbook \
                        -i infra/ansible/inventory/prod.ini \
                        infra/ansible/rollback_logic.yml || true

                    '''

                }

            }

        }

        always {

            script {

                sh 'docker logout || true'

                cleanWs()

            }

        }

    }
}